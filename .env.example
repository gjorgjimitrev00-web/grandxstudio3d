DATABASE_URL="mysql://USER:PERCENT_ENCODED_PASSWORD@HOST:3306/DATABASE?connection_limit=5&pool_timeout=20"
AUTH_SECRET="replace-with-at-least-32-random-bytes"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# bridge for production, local for development only
MEDIA_DRIVER="bridge"
MEDIA_BASE_URL="https://media.your-domain.mk"
MEDIA_UPLOAD_URL="https://media.your-domain.mk/bridge.php"
MEDIA_UPLOAD_SECRET="replace-with-a-different-64-character-random-secret"
# Development only, always outside checkout; never a public web root
LOCAL_MEDIA_ROOT="/tmp/grandxstudio-media"
# One-time bootstrap: set in hPanel, redeploy, then remove immediately
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""
# Only enable when your reverse proxy strips and overwrites x-forwarded-for
TRUST_PROXY="false"
# Analytics only: use the real-client-IP header supplied and overwritten by your host.
# Supported: x-forwarded-for, x-real-ip, cf-connecting-ip. Not used for authorization.
ANALYTICS_IP_HEADER="x-forwarded-for"
# Optional AI chat: server-only key; never use NEXT_PUBLIC_ for secrets.
# Add the key in Hostinger, redeploy, then enable AI in Admin > Live chat.
OPENAI_API_KEY=""
OPENAI_CHAT_MODEL="gpt-4.1-mini"
# Maximum AI requests per UTC day bucket, shared by the whole shop (default 300).
# Also capped at 20 requests per conversation per day and 10 per IP/minute.
OPENAI_CHAT_DAILY_LIMIT="300"
